{
  "name": "ContactSubmission",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Read",
        "Responded",
        "Archived"
      ],
      "default": "New",
      "title": "Status"
    }
  },
  "required": [
    "name",
    "phone",
    "message"
  ]
}